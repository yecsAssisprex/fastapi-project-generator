"""Contratos de entrada/salida del recurso de ejemplo."""

import re
import uuid
from datetime import datetime

from pydantic import BaseModel, ConfigDict, Field, field_validator

#: Minusculas, numeros y guiones simples: `mi-ejemplo`.
SLUG_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")


class IdentityRead(BaseModel):
    """Quien esta llamando, tal como lo ve el servicio."""

    national_id: str


class ExampleCreate(BaseModel):
    # Un campo desconocido en el body es un error del cliente, no algo a ignorar en
    # silencio: casi siempre es una errata en el nombre.
    model_config = ConfigDict(extra="forbid")

    slug: str = Field(min_length=2, max_length=120, examples=["mi-ejemplo"])
    label: str = Field(min_length=2, max_length=200, examples=["Mi ejemplo"])
    description: str | None = None

    @field_validator("slug")
    @classmethod
    def _valid_slug(cls, value: str) -> str:
        cleaned = value.strip().lower()
        if not SLUG_PATTERN.match(cleaned):
            raise ValueError("solo minusculas, numeros y guiones simples (ej. mi-ejemplo)")
        return cleaned


class ExampleUpdate(BaseModel):
    model_config = ConfigDict(extra="forbid")

    label: str | None = Field(default=None, min_length=2, max_length=200)
    description: str | None = None


class ExampleRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: uuid.UUID
    slug: str
    label: str
    description: str | None
    created_at: datetime
    updated_at: datetime
